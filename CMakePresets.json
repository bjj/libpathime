{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-base",
      "displayName": "Linux · Debug (Ninja)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "inherits": "linux-base",
      "displayName": "Linux · Release (Ninja)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-coverage",
      "inherits": "linux-base",
      "displayName": "Linux · test coverage (Ninja)",
      "description": "Instrumented for test coverage. Build it, then `cmake --build --preset linux-coverage --target pathime-test-coverage` — the target runs the suites but does not build them. Needs gcovr. See BUILD.md, \"Test coverage\".",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIBPATHIME_BUILD_TESTS": "ON",
        "LIBPATHIME_TEST_COVERAGE": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows · MSVC (Visual Studio 2022)",
      "description": "Needs VCPKG_ROOT set and `vcpkg install glib sqlite3` for pyzy (uuid comes from the bundled Rpcrt4 shim). Pass -DCMAKE_INSTALL_PREFIX here rather than to `cmake --install --prefix`: the generated pathime.pc records absolute paths, settled at configure time. See BUILD.md.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows · Ninja + clang-cl",
      "description": "Run from a Visual Studio developer command prompt — and re-set VCPKG_ROOT afterwards, because vcvars points it at the vcpkg bundled with Visual Studio.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" },
    { "name": "windows-msvc",  "configurePreset": "windows-msvc",  "configuration": "Release", "jobs": 0 },
    { "name": "windows-ninja", "configurePreset": "windows-ninja" }
  ]
}

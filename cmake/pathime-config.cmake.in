# The find_package(pathime) entry point, generated from
# cmake/pathime-config.cmake.in by cmake/LibpathimeInstall.cmake.
#
#   find_package(pathime REQUIRED)
#   target_link_libraries(app PRIVATE libpathime::pathime)
#
# That one target carries the include directory, the PATHIME_STATIC definition
# a static build needs, and the library itself. The vendored backends are not
# named here and are not linkable: in a shared build they are behind
# libpathime's own RPATH, which is the arrangement cmake/LibpathimeInstall.cmake
# describes.

@PACKAGE_INIT@

# Which backends this build has, matching the PATHIME_WITH_* of
# <pathime/config.h> so a consumer can branch in CMake as well as in C.
set(PATHIME_WITH_HANGUL @PATHIME_WITH_HANGUL@)
set(PATHIME_WITH_ANTHY  @PATHIME_WITH_ANTHY@)
set(PATHIME_WITH_PYZY   @PATHIME_WITH_PYZY@)
set(PATHIME_WITH_TABLE  @PATHIME_WITH_TABLE@)
set(PATHIME_STATIC_BUILD @PATHIME_BUILT_STATIC@)

# The engines' read-only data, for a consumer that copies it next to its own
# binary rather than keeping libpathime and the data together. See BUILD.md,
# "Shipping the data"; pathime_init_params_t::resource_dir is the other half.
#
# A plain set(), not set_and_check(): a build whose backends ship no data — a
# Korean-only one, or a table build without engines/ibus-table-chinese — creates
# no such directory, and set_and_check() would turn that into a FATAL_ERROR that
# not even find_package(pathime QUIET) could get past. The variable still names
# where the data would be, which is what a consumer asks it for.
set(PATHIME_DATA_DIR "@PACKAGE_LIBPATHIME_INSTALL_DATADIR@")

# A static libpathime puts the vendored backends on the consumer's link line,
# so the external libraries those backends need have to be found again here.
# A shared build needs none of it: they are resolved inside libpathime.so.
#
# Every probe reports a miss the way find_package() is defined to: pathime_FOUND
# false with a message, so that REQUIRED decides whether it is fatal and a
# consumer probing optionally gets to fall back. pkg_check_modules(REQUIRED)
# would call message(FATAL_ERROR) itself and take the consumer's configure with
# it.
if(PATHIME_STATIC_BUILD)
  include(CMakeFindDependencyMacro)
  if(PATHIME_WITH_PYZY OR PATHIME_WITH_TABLE)
    find_dependency(SQLite3)
  endif()
  if(PATHIME_WITH_PYZY)
    find_dependency(PkgConfig)
    # The prefixes are the project's own, matching the imported targets recorded
    # in pathime-targets.cmake. This code runs in the consumer's scope, where a
    # bare GLIB or UUID would answer their own pkg_check_modules(GLIB ...) with
    # this query's results; and no GLOBAL, because a package promoting imported
    # targets the consumer never asked for is the same overreach one step
    # further. The export's own targets are directory-scoped too, and reach a
    # consumer's subdirectories the same way these do.
    pkg_check_modules(LIBPATHIME_GLIB IMPORTED_TARGET "glib-2.0 >= 2.24.0")
    if(NOT LIBPATHIME_GLIB_FOUND)
      set(pathime_FOUND FALSE)
      set(pathime_NOT_FOUND_MESSAGE "glib-2.0 >= 2.24.0 not found; a static \
libpathime with the Chinese backend puts pyzy on the consumer's link line, and \
pyzy needs it.")
      return()
    endif()
    if(NOT WIN32)
      pkg_check_modules(LIBPATHIME_UUID IMPORTED_TARGET uuid)
      if(NOT LIBPATHIME_UUID_FOUND)
        set(pathime_FOUND FALSE)
        set(pathime_NOT_FOUND_MESSAGE "uuid (libuuid) not found; a static \
libpathime with the Chinese backend puts pyzy on the consumer's link line, and \
pyzy needs it.")
        return()
      endif()
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pathime-targets.cmake")

check_required_components(pathime)

/* config.h for anthy-unicode, generated by libpathime's CMake port.
 * Mirrors the fields the upstream meson build puts in config.h (PACKAGE,
 * VERSION, HAVE_STRERROR_R); CONF_DIR is supplied as a compile definition. */
#ifndef LIBPATHIME_ANTHY_CONFIG_H
#define LIBPATHIME_ANTHY_CONFIG_H

#define PACKAGE "@ANTHY_PACKAGE@"
#define VERSION "@ANTHY_VERSION@"

#cmakedefine HAVE_STRERROR_R 1

#endif /* LIBPATHIME_ANTHY_CONFIG_H */

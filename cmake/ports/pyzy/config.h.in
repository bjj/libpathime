/* config.h for pyzy, generated by libpathime's CMake port.
 * pyzy's sources only consult HAVE_LIBUUID (uuid backend) and HAVE_OPENCC
 * (optional, left off). PKGDATADIR is passed as a compile definition. */
#ifndef LIBPATHIME_PYZY_CONFIG_H
#define LIBPATHIME_PYZY_CONFIG_H

#cmakedefine HAVE_LIBUUID 1

#endif /* LIBPATHIME_PYZY_CONFIG_H */

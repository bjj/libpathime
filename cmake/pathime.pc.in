# pkg-config metadata for libpathime, generated by cmake/LibpathimeInstall.cmake.
#
# The paths derive from ${pcfiledir} — the directory this file is read from —
# whenever the install layout permits it, which is every layout whose
# GNUInstallDirs directories are the default prefix-relative form. That is what
# lets an installed tree be moved, or unpacked from an archive at any prefix,
# with the file staying true; the library finds its own data the same way, by
# asking the loader where it is (BUILD.md, "Shipping the data"). A layout with
# an absolute CMAKE_INSTALL_LIBDIR, INCLUDEDIR or BINDIR is pinned to its
# configure-time paths instead — pinned as a whole, because a file half
# anchored to ${pcfiledir} and half to absolute paths would come apart the
# first time the tree moved.
prefix=@PATHIME_PC_PREFIX@
exec_prefix=${prefix}
libdir=@PATHIME_PC_LIBDIR@
includedir=@PATHIME_PC_INCLUDEDIR@

# The engines' read-only data. Not a variable pkg-config knows about; it is here
# because a client that separates code from data needs the path to hand to
# pathime_init_params_t::resource_dir, and this is the file that knows it.
datadir=@PATHIME_PC_DATADIR@

Name: libpathime
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Cflags: -I${includedir}@PATHIME_PC_CFLAGS@
Libs: -L${libdir} @PATHIME_PC_LIB@
Libs.private:@PATHIME_PC_LIBS_PRIVATE@
Requires.private:@PATHIME_PC_REQUIRES_PRIVATE@

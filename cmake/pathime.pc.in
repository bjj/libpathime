# pkg-config metadata for libpathime, generated by cmake/LibpathimeInstall.cmake.
#
# The paths are absolute rather than derived from ${pcfiledir}, because the
# install prefix is already a configure-time decision for this build — BUILD.md
# says why under "What gets produced" — and a relative form would only be
# honest for some of the tree.
prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

# The engines' read-only data. Not a variable pkg-config knows about; it is here
# because a client that separates code from data needs the path to hand to
# pathime_init_params_t::resource_dir, and this is the file that knows it.
datadir=@LIBPATHIME_INSTALL_FULL_DATADIR@

Name: libpathime
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Cflags: -I${includedir}@PATHIME_PC_CFLAGS@
Libs: -L${libdir} -lpathime
Libs.private:@PATHIME_PC_LIBS_PRIVATE@
Requires.private:@PATHIME_PC_REQUIRES_PRIVATE@
